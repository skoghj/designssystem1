---

import "../styles/tailwind.css";
import { carouselItems } from "../components/carouselItems.js";
---

<html lang="dk">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Prompt:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>Archive — Intro</title>
  </head>
  <body class="h-screen w-screen overflow-hidden bg-neutral-50 font-sans text-neutral-900 antialiased">
    <main id="app" class="relative flex h-[100dvh] w-screen flex-col md:block md:overflow-hidden">
      <!-- ============================================================
           CAROUSEL — 데스크탑 기준 왼쪽 ~55%. 타원 중심은 JS에서
           뷰포트 왼쪽 바깥으로 밀어내서(ELLIPSE CONFIG) 오른쪽 호만
           보이게 함.
      ============================================================= -->
      <section
        id="carousel"
        tabindex="0"
        aria-label="사진 아카이브 캐러셀. 위/아래 방향키, 휠, 드래그, 클릭으로 탐색"
        class="relative h-[46vh] w-full shrink-0 cursor-grab touch-none
               select-none outline-none active:cursor-grabbing
               focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2
               focus-visible:ring-offset-neutral-50 md:h-full md:w-[55%]"
      >
        <div id="carousel-track" class="relative h-full w-full">
          {
            carouselItems.map((item, i: number) => (
              <button
                type="button"
                class="carousel-item absolute left-0 top-0 aspect-[4/5] w-[26vw] max-w-[220px] min-w-[120px]
                       touch-none select-none overflow-hidden rounded-none outline-none
                       transition-[filter,opacity] duration-300 ease-out motion-reduce:transition-none
                       focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2
                       focus-visible:ring-offset-neutral-50 md:w-[16vw]"
                data-index={i}
                aria-label={`${item.number}. ${item.title} — ${item.subtitle} 보기`}
              >
                <img
                  src={item.coverImage}
                  alt={`${item.title}, ${item.subtitle}`}
                  class="h-full w-full object-cover"
                  loading={i < 3 ? "eager" : "lazy"}
                  draggable="false"
                />
              </button>
            ))
          }
        </div>
      </section>

      <!-- 활성 사진 → 디테일 패널을 잇는 얇은 연결선 -->
      <div
        id="connector-line"
        class="pointer-events-none absolute top-1/2 z-10 hidden h-px bg-red-500 md:block"
        aria-hidden="true"
      >
        <span class="absolute -left-[3px] -top-[3px] h-[6px] w-[6px] rounded-full bg-red-500"></span>
        <span class="absolute -right-[3px] -top-[3px] h-[6px] w-[6px] rounded-full bg-red-500"></span>
      </div>

      <!-- ============================================================
           DETAIL PANEL — 데스크탑 오른쪽 ~45%, 모바일에선 캐러셀 아래로.
      ============================================================= -->
      <section
        id="detail"
        class="relative flex h-[54vh] w-full flex-col justify-center gap-s overflow-y-auto px-s py-m
               md:absolute md:right-0 md:top-0 md:h-full md:w-[45%] md:gap-m md:px-l lg:px-xl"
      >
        <div
          id="detail-content"
          class="max-w-xl opacity-100 translate-y-0 transition-all duration-300 ease-out motion-reduce:transition-none"
        >
          <div class="mb-s flex items-baseline gap-xs border-b border-neutral-200 pb-xs">
            <span id="detail-number" class="text-konsultativ tracking-[0.2em] text-red-600">01</span>
            <span class="text-konsultativ tracking-[0.2em] text-neutral-400">/ 08</span>
          </div>

          <h1
            id="detail-title"
            aria-live="polite"
            class="font-display text-large font-medium leading-[1.05] text-neutral-900 md:text-xlarge"
          >Origins</h1>

          <p id="detail-subtitle" class="mt-xxs text-body tracking-wide text-neutral-500">
            Seoul · 1990–2010
          </p>

          <p id="detail-description" class="mt-s max-w-md text-body leading-relaxed text-neutral-700 md:text-base">
            The earliest layer of the archive — unlabeled negatives, borrowed cameras, streets photographed before they had names worth remembering.
          </p>

          <div id="detail-gallery" class="mt-m grid grid-cols-2 gap-xxs">
            <img
              data-role="large"
              class="detail-img col-span-2 h-[22vh] w-full translate-y-2 rounded-none object-cover
                     opacity-0 transition-all duration-500 ease-out motion-reduce:transition-none md:h-[26vh]"
              src=""
              alt=""
              loading="lazy"
            />
            <img
              data-role="small-1"
              class="detail-img h-[13vh] w-full translate-y-2 rounded-none object-cover
                     opacity-0 transition-all duration-500 ease-out motion-reduce:transition-none md:h-[15vh]"
              src=""
              alt=""
              loading="lazy"
            />
            <img
              data-role="small-2"
              class="detail-img h-[13vh] w-full translate-y-2 rounded-none object-cover
                     opacity-0 transition-all duration-500 ease-out motion-reduce:transition-none md:h-[15vh]"
              src=""
              alt=""
              loading="lazy"
            />
          </div>

          <ul id="detail-tags" class="mt-s flex flex-wrap gap-xxs" aria-label="키워드 태그"></ul>
        </div>
      </section>
    </main>

    <script define:vars={{ items: carouselItems }}>
      // ================================================================
      // STATE
      // ================================================================
      let currentIndex = 0;
      let targetIndex = 0;
      let velocity = 0;
      let activeIndex = 0;
      let rafId = null;

      const n = items.length;
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      const carousel = document.getElementById("carousel");
      const itemEls = Array.from(document.querySelectorAll(".carousel-item"));
      const connector = document.getElementById("connector-line");

      // ================================================================
      // ELLIPSE CONFIG — x = cx + rx·cosθ, y = cy + ry·sinθ. θ = 0이
      // 활성(오른쪽-중앙) 지점. centerX(또는 모바일에선 centerY)를
      // 화면 밖으로 밀어내서 곡선의 절반만 보이게 함.
      // ================================================================
      let ellipse = { centerX: 0, centerY: 0, radiusX: 0, radiusY: 0 };
      let isMobile = false;

      function computeEllipseConfig() {
        const rect = carousel.getBoundingClientRect();
        isMobile = window.matchMedia("(max-width: 767px)").matches;

        if (!isMobile) {
          ellipse.centerX = -Math.min(280, rect.width * 0.42);
          ellipse.centerY = rect.height / 2;
          ellipse.radiusX = Math.min(640, Math.max(360, rect.width * 0.95));
          ellipse.radiusY = Math.min(820, Math.max(420, rect.height * 1.05));
        } else {
          ellipse.centerX = rect.width / 2;
          ellipse.centerY = -Math.min(180, rect.height * 0.55);
          ellipse.radiusX = Math.min(520, Math.max(280, rect.width * 1.05));
          ellipse.radiusY = Math.min(360, Math.max(200, rect.height * 1.4));
        }
      }

      const ANGLE_STEP = (24 * Math.PI) / 180;
      const FADE_RANGE = (95 * Math.PI) / 180;

      function lerp(a, b, t) {
        return a + (b - a) * t;
      }
      function clamp01(v) {
        return Math.min(1, Math.max(0, v));
      }

      // ================================================================
      // RENDER — 아이템 하나하나 개별 계산 (컨테이너 통째로 회전 X)
      // ================================================================
      function render() {
        const rect = carousel.getBoundingClientRect();

        itemEls.forEach((el, i) => {
          const theta = (i - currentIndex) * ANGLE_STEP;
          const cos = Math.cos(theta);
          const sin = Math.sin(theta);

          const x = ellipse.centerX + ellipse.radiusX * cos;
          const y = ellipse.centerY + ellipse.radiusY * sin;

          const tangentX = -ellipse.radiusX * sin;
          const tangentY = ellipse.radiusY * cos;
          let tangentAngleDeg = (Math.atan2(tangentY, tangentX) * 180) / Math.PI;
          let rotationDeg = isMobile ? tangentAngleDeg : tangentAngleDeg - 90;
          rotationDeg *= 0.6;

          const distance = Math.abs(theta);
          const t = clamp01(distance / FADE_RANGE);

          const scale = lerp(1, 0.52, t);
          const opacity = lerp(
            1,
            0,
            clamp01((distance - FADE_RANGE * 0.75) / (FADE_RANGE * 0.5))
          );
          const brightness = lerp(1, 0.55, t);
          const blurPx = lerp(0, 6, t);
          const zIndex = Math.round(lerp(50, 1, t));

          el.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%) rotate(${rotationDeg}deg) scale(${scale})`;
          el.style.opacity = String(opacity);
          el.style.zIndex = String(zIndex);
          el.style.filter = `brightness(${brightness}) blur(${blurPx}px)`;
          el.style.pointerEvents = opacity < 0.08 ? "none" : "auto";
          el.setAttribute("aria-hidden", opacity < 0.08 ? "true" : "false");

          const isActive = Math.abs(i - currentIndex) < 0.5;
          el.dataset.active = isActive ? "true" : "false";
        });

        const activeX = ellipse.centerX + ellipse.radiusX * Math.cos(0);
        const activeY = ellipse.centerY + ellipse.radiusY * Math.sin(0);
        const lineLeft = rect.left + activeX;
        const detailRect = document.getElementById("detail").getBoundingClientRect();
        const lineWidth = Math.max(0, detailRect.left - lineLeft);
        connector.style.left = `${lineLeft}px`;
        connector.style.top = `${rect.top + activeY}px`;
        connector.style.width = `${lineWidth}px`;
      }

      // ================================================================
      // SPRING LOOP
      // ================================================================
      const STIFFNESS = 0.09;
      const DAMPING = 0.62;

      function tick() {
        const delta = targetIndex - currentIndex;
        const accel = delta * STIFFNESS - velocity * DAMPING;
        velocity += accel;
        currentIndex += velocity;

        render();

        if (Math.abs(delta) > 0.001 || Math.abs(velocity) > 0.001) {
          rafId = requestAnimationFrame(tick);
        } else {
          currentIndex = targetIndex;
          velocity = 0;
          render();
          rafId = null;
          commitActiveIndex();
        }
      }

      function startLoop() {
        if (rafId === null) rafId = requestAnimationFrame(tick);
      }

      function setTarget(newTarget) {
        targetIndex = newTarget;
        if (prefersReducedMotion) {
          currentIndex = newTarget;
          velocity = 0;
          render();
          commitActiveIndex();
        } else {
          startLoop();
        }
      }

      function goToIndex(rawIndex) {
        const current = Math.round(currentIndex);
        let delta = (((rawIndex - current + n / 2) % n) + n) % n - n / 2;
        setTarget(currentIndex + delta);
      }

      function step(direction) {
        setTarget(targetIndex + direction);
      }

      // ================================================================
      // DETAIL PANEL — 상태 전환은 전부 Tailwind 유틸리티 클래스
      // (opacity-*, translate-y-*) 토글로 처리. transition 자체는
      // 마크업에 이미 있는 duration/ease 클래스가 담당.
      // ================================================================
      const HIDDEN_DOWN = ["opacity-0", "translate-y-2"];
      const HIDDEN_UP = ["opacity-0", "-translate-y-2"];
      const VISIBLE = ["opacity-100", "translate-y-0"];

      const detailContent = document.getElementById("detail-content");
      const numberEl = document.getElementById("detail-number");
      const titleEl = document.getElementById("detail-title");
      const subtitleEl = document.getElementById("detail-subtitle");
      const descriptionEl = document.getElementById("detail-description");
      const tagsEl = document.getElementById("detail-tags");
      const galleryImgs = {
        large: document.querySelector('[data-role="large"]'),
        "small-1": document.querySelector('[data-role="small-1"]'),
        "small-2": document.querySelector('[data-role="small-2"]'),
      };

      function wrapIndex(i) {
        return ((i % n) + n) % n;
      }

      function fillDetail(item) {
        numberEl.textContent = item.number;
        titleEl.textContent = item.title;
        subtitleEl.textContent = item.subtitle;
        descriptionEl.textContent = item.description;

        galleryImgs.large.src = item.galleryImages[0];
        galleryImgs.large.alt = `${item.title} — 관련 이미지 1`;
        galleryImgs["small-1"].src = item.galleryImages[1];
        galleryImgs["small-1"].alt = `${item.title} — 관련 이미지 2`;
        galleryImgs["small-2"].src = item.galleryImages[2];
        galleryImgs["small-2"].alt = `${item.title} — 관련 이미지 3`;

        tagsEl.innerHTML = "";
        item.tags.forEach((tag) => {
          const li = document.createElement("li");
          li.className =
            "detail-tag rounded-full border border-neutral-300 px-xs py-xxs text-konsultativ tracking-wide text-neutral-600 opacity-0 translate-y-2 transition-all duration-300 ease-out motion-reduce:transition-none";
          li.textContent = tag;
          tagsEl.appendChild(li);
        });
      }

      function revealDetailChildren() {
        const imgs = Object.values(galleryImgs);
        const tags = Array.from(tagsEl.children);
        [...imgs, ...tags].forEach((el, i) => {
          el.classList.remove(...VISIBLE);
          el.classList.add(...HIDDEN_DOWN);
          setTimeout(() => {
            el.classList.remove(...HIDDEN_DOWN);
            el.classList.add(...VISIBLE);
          }, 60 * i + 40);
        });
      }

      let detailTransitionTimeout = null;

      function updateDetail(item) {
        if (prefersReducedMotion) {
          fillDetail(item);
          revealDetailChildren();
          return;
        }

        clearTimeout(detailTransitionTimeout);
        detailContent.classList.remove(...VISIBLE, ...HIDDEN_UP);
        detailContent.classList.add(...HIDDEN_DOWN);

        detailTransitionTimeout = setTimeout(() => {
          fillDetail(item);
          detailContent.classList.remove(...HIDDEN_DOWN);
          detailContent.classList.add(...HIDDEN_UP);
          void detailContent.offsetWidth; // reflow
          detailContent.classList.remove(...HIDDEN_UP);
          detailContent.classList.add(...VISIBLE);
          revealDetailChildren();
        }, 260);
      }

      function commitActiveIndex() {
        const wrapped = wrapIndex(Math.round(currentIndex));
        if (wrapped !== activeIndex) {
          activeIndex = wrapped;
          updateDetail(items[activeIndex]);
        }
      }

      // ================================================================
      // INTERACTION — 클릭 / 휠 / 드래그 / 키보드
      // ================================================================
      itemEls.forEach((el) => {
        el.addEventListener("click", () => {
          const idx = Number(el.dataset.index);
          goToIndex(idx);
        });
      });

      let wheelLocked = false;
      carousel.addEventListener(
        "wheel",
        (e) => {
          e.preventDefault();
          if (wheelLocked) return;
          const delta = isMobile ? e.deltaX || e.deltaY : e.deltaY;
          if (Math.abs(delta) < 4) return;
          wheelLocked = true;
          step(delta > 0 ? 1 : -1);
          setTimeout(() => (wheelLocked = false), 140);
        },
        { passive: false }
      );

      let dragging = false;
      let dragStartPos = 0;
      let dragStartIndex = 0;
      const DRAG_PX_PER_STEP = 90;

      function pointerPos(e) {
        return isMobile ? e.clientX : e.clientY;
      }

      carousel.addEventListener("pointerdown", (e) => {
        dragging = true;
        dragStartPos = pointerPos(e);
        dragStartIndex = currentIndex;
        velocity = 0;
        carousel.setPointerCapture(e.pointerId);
      });

      carousel.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        e.preventDefault();
        const delta = pointerPos(e) - dragStartPos;
        currentIndex = dragStartIndex + (-1 * delta) / DRAG_PX_PER_STEP;
        targetIndex = currentIndex;
        render();
      });

      function endDrag() {
        if (!dragging) return;
        dragging = false;
        goToIndex(Math.round(currentIndex));
      }

      carousel.addEventListener("pointerup", endDrag);
      carousel.addEventListener("pointercancel", endDrag);
      carousel.addEventListener("pointerleave", (e) => {
        if (dragging && e.buttons === 0) endDrag();
      });

      carousel.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown" || e.key === "ArrowRight") {
          e.preventDefault();
          step(1);
        } else if (e.key === "ArrowUp" || e.key === "ArrowLeft") {
          e.preventDefault();
          step(-1);
        }
      });

      carousel.addEventListener(
        "touchmove",
        (e) => {
          if (dragging) e.preventDefault();
        },
        { passive: false }
      );

      // ================================================================
      // RESIZE / INIT
      // ================================================================
      let resizeTimeout;
      window.addEventListener("resize", () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
          computeEllipseConfig();
          render();
        }, 100);
      });

      computeEllipseConfig();
      render();
      fillDetail(items[0]);
      revealDetailChildren();
    </script>
  </body>
</html>